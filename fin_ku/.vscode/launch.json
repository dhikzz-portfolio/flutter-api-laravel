{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "cwd": "${workspaceFolder}",
      "deviceId": "chrome",
      "preLaunchTask": "laravel:serve"
    },
    {
      "name": "Flutter (Windows desktop - butuh VS Build Tools)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "cwd": "${workspaceFolder}",
      "deviceId": "windows",
      "preLaunchTask": "laravel:serve"
    },
    {
      "name": "Flutter (Android Emulator)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "cwd": "${workspaceFolder}",
      "deviceId": "Medium_Phone",
      "preLaunchTask": "laravel:serve"
    },
    {
      "name": "Flutter (HP fisik LAN)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "cwd": "${workspaceFolder}",
      "args": ["--dart-define=API_BASE_URL=http://192.168.50.132:8000"],
      "preLaunchTask": "laravel:serve"
    },
    {
      "name": "Flutter (pilih device)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "laravel:serve"
    }
  ]
}
