{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Flutter (Windows)",
      "request": "launch",
      "type": "dart",
      "program": "fin_ku/lib/main.dart",
      "cwd": "${workspaceFolder}/fin_ku",
      "deviceId": "windows",
      "preLaunchTask": "laravel:serve"
    },
    {
      "name": "Flutter (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "fin_ku/lib/main.dart",
      "cwd": "${workspaceFolder}/fin_ku",
      "deviceId": "chrome",
      "preLaunchTask": "laravel:serve"
    },
    {
      "name": "Flutter (Android Emulator)",
      "request": "launch",
      "type": "dart",
      "program": "fin_ku/lib/main.dart",
      "cwd": "${workspaceFolder}/fin_ku",
      "deviceId": "Medium_Phone",
      "preLaunchTask": "laravel:serve"
    },
    {
      "name": "Flutter (HP fisik LAN)",
      "request": "launch",
      "type": "dart",
      "program": "fin_ku/lib/main.dart",
      "cwd": "${workspaceFolder}/fin_ku",
      "args": ["--dart-define=API_BASE_URL=http://192.168.50.132:8000"],
      "preLaunchTask": "laravel:serve"
    },
    {
      "name": "Flutter (pilih device)",
      "request": "launch",
      "type": "dart",
      "program": "fin_ku/lib/main.dart",
      "cwd": "${workspaceFolder}/fin_ku",
      "preLaunchTask": "laravel:serve"
    }
  ]
}
